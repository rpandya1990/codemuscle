#!/usr/bin/env bash

set -euo pipefail

TASK_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TASK_REPOSITORY_DIR="$(cd "${TASK_SCRIPT_DIR}/.." && pwd)"
TASK_WORKSPACE_PATH="${CODEMUSCLE_WORKSPACE_PATH:-${HOME}/CodeMuscleData}"

cd "${TASK_REPOSITORY_DIR}"

usage() {
  echo "Usage: ./scripts/codemuscle {start|stop|restart|status|logs}"
  echo
  echo "Optional: CODEMUSCLE_WORKSPACE_PATH=/absolute/path ./scripts/codemuscle start"
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

wait_for_api() {
  local attempt
  for attempt in {1..30}; do
    if curl --silent --fail http://localhost:8000/api/v1/health >/dev/null; then
      return 0
    fi
    sleep 1
  done
  echo "The API did not become healthy. Run './scripts/codemuscle logs' for details." >&2
  return 1
}

start() {
  require_command docker
  require_command uv
  require_command curl

  if ! docker info >/dev/null 2>&1; then
    echo "Docker is not running. Start Docker Desktop and try again." >&2
    exit 1
  fi

  if [[ ! -f .env ]]; then
    cp .env.example .env
    echo "Created .env from .env.example."
  fi

  echo "Installing backend tooling..."
  uv sync --project apps/api --all-groups

  echo "Starting PostgreSQL..."
  docker compose up -d postgres

  echo "Applying database migrations..."
  uv run --project apps/api alembic -c apps/api/alembic.ini upgrade head

  echo "Building and starting CodeMuscle..."
  docker compose up -d --build api web
  wait_for_api

  echo "Initializing private workspace at ${TASK_WORKSPACE_PATH}..."
  curl --silent --fail --request POST http://localhost:8000/api/v1/workspace/initialize \
    --header "Content-Type: application/json" \
    --data "$(printf '{\"path\":\"%s\"}' "${TASK_WORKSPACE_PATH}")" >/dev/null

  echo
  echo "CodeMuscle is running:"
  echo "  App:      http://localhost:3000"
  echo "  API docs: http://localhost:8000/docs"
  echo "  Data:     ${TASK_WORKSPACE_PATH}"
}

stop() {
  require_command docker
  docker compose down
  echo "CodeMuscle stopped. Database and workspace data were preserved."
}

status() {
  require_command docker
  docker compose ps
  if curl --silent --fail http://localhost:8000/api/v1/health >/dev/null 2>&1; then
    echo "API health: ok"
  else
    echo "API health: unavailable"
  fi
}

logs() {
  require_command docker
  docker compose logs --follow --tail=100
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart)
    stop
    start
    ;;
  status) status ;;
  logs) logs ;;
  *)
    usage
    exit 1
    ;;
esac

